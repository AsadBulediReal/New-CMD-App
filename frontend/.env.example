# Frontend Environment Variables Configuration
#
# Production Backend URL (e.g., https://your-backend-api.onrender.com or https://api.yourdomain.com)
# When deploying the frontend, set VITE_API_URL in your hosting provider's environment variables settings.
# If left unset, it falls back to http://localhost:5000 for local development.

VITE_API_URL=http://localhost:5000
