# ==============================================================================
# CMD Finance Platform — Environment Configuration (.env)
# ==============================================================================
# Place a copy of this file named ".env" in this root directory (next to docker-compose.yml)
# or in the "server/" folder when running standalone.

# --- Core Server & Security Settings ---
PORT=5000
JWT_SECRET=your-random-64-character-jwt-secret-key-change-me
ADMIN_EMAIL=admin@usindh.edu.pk
FRONTEND_URL=http://localhost

# --- Optional: Google OAuth 2.0 (For Google Sign-In) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Optional: SMTP Mail Configuration (For Registration Alerts & Password Resets) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-16-char-app-password
EMAIL_FROM="CMD Portal <no-reply@usindh.edu.pk>"

# --- Database URI (Handled automatically by Docker, only needed for standalone Node) ---
# MONGODB_URI=mongodb://localhost:27017/cmd_app
