# Server Environment Variables Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cmd_finance?retryWrites=true&w=majority
JWT_SECRET=your-secure-jwt-secret-key
ADMIN_EMAIL=admin@usindh.edu.pk

# Google OAuth 2.0 Client ID for token audience verification
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP Mail Settings for Notifications & Approvals
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="CMD Portal <no-reply@usindh.edu.pk>"
FRONTEND_URL=http://localhost:5173
